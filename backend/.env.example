PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL local o proveedor cloud como Neon.
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/calendar_app
DB_SSL=false

JWT_SECRET=cambia-esta-clave-por-una-larga-y-segura
JWT_EXPIRES_IN=7d

# Envío de verificación. MAIL_FROM debe pertenecer a un dominio validado en Resend.
MAIL_TRANSPORT=resend
MAIL_FROM=Calendar <verificacion@tu-dominio.example>
RESEND_API_KEY=
# FRONTEND_URL debe ser la URL pública del frontend y usar HTTPS en producción.
